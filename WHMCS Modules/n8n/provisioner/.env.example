PORT=8080
HOST=0.0.0.0

# Bearer token expected from WHMCS module
API_BEARER_TOKEN=replace-me

# Callback target in WHMCS
WHMCS_CALLBACK_URL=https://your-whmcs-host/modules/servers/n8nproxmox/callback.php
WHMCS_CALLBACK_BEARER_TOKEN=replace-me

# Optional HMAC secret for callback signature
WHMCS_CALLBACK_HMAC_SECRET=

# Worker settings
JOB_RETRY_MAX=5
JOB_RETRY_DELAY_MS=10000

# Proxmox API
PROXMOX_API_URL=https://127.0.0.1:8006/api2/json
PROXMOX_API_TOKEN_ID=root@pam!whmcs
PROXMOX_API_TOKEN_SECRET=replace-me
PROXMOX_TLS_INSECURE=true

# LXC provisioning defaults
PROXMOX_NODE_DEFAULT=pve-node-01
PROXMOX_REGION_NODE_MAP={"default":"pve-node-01"}
PROXMOX_LXC_TEMPLATE_VMID=9000
PROXMOX_STORAGE=local-lvm
PROXMOX_BRIDGE=vmbr0
PROXMOX_SWAP_MB=512

# n8n deployment controls
N8N_PUBLIC_BASE_DOMAIN=n8n.yourdomain.com
N8N_DEFAULT_SCHEME=https
N8N_HEALTH_CHECK_PATH=/healthz
N8N_DEPLOY_TIMEOUT_MS=300000
N8N_DEPLOY_POLL_MS=5000

# Optional external automation hooks (recommended)
N8N_DEPLOY_HOOK_URL=
N8N_DEPLOY_HOOK_TOKEN=
N8N_LIMITS_HOOK_URL=
N8N_LIMITS_HOOK_TOKEN=
N8N_BACKUP_HOOK_URL=
N8N_BACKUP_HOOK_TOKEN=
