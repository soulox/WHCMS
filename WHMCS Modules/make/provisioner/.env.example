PORT=8080
HOST=0.0.0.0

# Bearer token expected from WHMCS module
API_BEARER_TOKEN=replace-me

# Callback target in WHMCS
WHMCS_CALLBACK_URL=https://your-whmcs-host/modules/servers/makeproxmox/callback.php
WHMCS_CALLBACK_BEARER_TOKEN=replace-me

# Optional HMAC secret for callback signature
WHMCS_CALLBACK_HMAC_SECRET=

# Worker settings
JOB_RETRY_MAX=5
JOB_RETRY_DELAY_MS=10000

# Proxmox API
PROXMOX_API_URL=https://127.0.0.1:8006/api2/json
PROXMOX_API_TOKEN_ID=root@pam!whmcs
PROXMOX_API_TOKEN_SECRET=replace-me
PROXMOX_TLS_INSECURE=true

# Proxmox defaults
PROXMOX_NODE_DEFAULT=pve-node-01
PROXMOX_REGION_NODE_MAP={"default":"pve-node-01"}
PROXMOX_LXC_TEMPLATE_VMID=9000
PROXMOX_KVM_TEMPLATE_VMID=9100
PROXMOX_STORAGE=local-lvm
PROXMOX_BRIDGE=vmbr0
PROXMOX_SWAP_MB=512

# Make deployment controls
MAKE_PUBLIC_BASE_DOMAIN=make.yourdomain.com
MAKE_DEFAULT_SCHEME=https
MAKE_HEALTH_CHECK_PATH=/health
MAKE_DEPLOY_TIMEOUT_MS=300000
MAKE_DEPLOY_POLL_MS=5000

# Optional external automation hooks
MAKE_DEPLOY_HOOK_URL=http://127.0.0.1:8090/hooks/deploy
MAKE_DEPLOY_HOOK_TOKEN=replace-me
MAKE_LIMITS_HOOK_URL=http://127.0.0.1:8090/hooks/limits
MAKE_LIMITS_HOOK_TOKEN=replace-me
MAKE_BACKUP_HOOK_URL=http://127.0.0.1:8090/hooks/backup
MAKE_BACKUP_HOOK_TOKEN=replace-me
